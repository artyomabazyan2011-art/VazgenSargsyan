}

/* Stylised Arevakhach (Armenian eternity sign) */
function EternitySign({ size = 48, color = "currentColor", className = "" }) {
  const arms = Array.from({ length: 8 }, (_, i) => i * 45);
  return (
    <svg
      width={size}
      height={size}
      viewBox="-50 -50 100 100"
      className={className}
      aria-hidden="true"
    >
      <g fill="none" stroke={color} strokeWidth="5" strokeLinecap="round">
        {arms.map((deg) => (
          <path
            key={deg}
            transform={`rotate(${deg})`}
            d="M0 -6 C 8 -18, 26 -20, 34 -8 C 40 2, 30 14, 20 10"
          />
        ))}
        <circle r="6" fill={color} stroke="none" />
      </g>
    </svg>
  );
}

